{
  "name": "realtime_server",
  "version": "1.0.0",
  "description": "OpenAI Realtime API + WebSocket example",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "analyze:kpis": "node experiment/analyzeKpis.js",
    "experiment:plan": "node ../../../../shared/scripts/experimentHarness.mjs plan --config ../../../../shared/experiments/voice-stimuli-2026.json",
    "experiment:preflight": "node ../../../../shared/scripts/experimentHarness.mjs preflight --config ../../../../shared/experiments/voice-stimuli-2026.json",
    "experiment:noise": "swift ../../../../shared/scripts/noisePlayback.swift ../../../../shared/experiments/voice-stimuli-2026.json",
    "experiment:play-command": "node ../../../../shared/scripts/experimentHarness.mjs play-command --config ../../../../shared/experiments/voice-stimuli-2026.json",
    "experiment:play-confirmation": "node ../../../../shared/scripts/experimentHarness.mjs play-confirmation --config ../../../../shared/experiments/voice-stimuli-2026.json",
    "experiment:validate": "node ../../../../shared/scripts/experimentHarness.mjs validate --config ../../../../shared/experiments/voice-stimuli-2026.json --prototype realtime --experiment-root experiment"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.55.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
